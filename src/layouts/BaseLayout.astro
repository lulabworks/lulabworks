---
import '../styles/global.css'
import { sitePath } from '../lib/public-content'

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = 'LuLab | Restauro, recupero e lavori artigianali nel Salento',
  description = 'LuLab restaura mobili e infissi, recupera arredi e realizza trattamenti antitarlo nel Salento.',
  image = sitePath('/brand/og-lulab.png')
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F4EF" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={sitePath('/favicon-16x16.png')} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={sitePath('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={sitePath('/site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Marchio geometrico LuLab" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand" href={sitePath('/')} aria-label="LuLab — home">
        <img src={sitePath('/brand/logo-lulab.png')} width="64" height="64" alt="" />
        <span>LuLab</span>
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Apri il menu"
        hidden
      >
        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Navigazione principale">
        <a href={sitePath('/servizi/')}>Servizi</a>
        <a href={sitePath('/collezione/')}>Collezione</a>
        <a href={sitePath('/progetti/')}>Progetti</a>
        <a class="nav-cta" href={sitePath('/richiesta/')}>Richiedi un preventivo</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand-lockup">
        <img src={sitePath('/brand/logo-lulab.png')} width="64" height="64" alt="" loading="lazy" />
        <div><strong>LuLab</strong><p>Restauro, recupero e lavorazioni artigianali nel Salento.</p></div>
      </div>
      <div class="footer-links">
        <a href="mailto:lulabworks@gmail.com">lulabworks@gmail.com</a>
        <a href="https://www.instagram.com/lulabworks/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.youtube.com/@LuLabWorks" target="_blank" rel="noopener noreferrer">YouTube</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} LuLab</p>
    </footer>
    <script>
      const mobileMenuQuery = window.matchMedia('(max-width: 800px)')
      const menuButton = document.querySelector<HTMLButtonElement>('.nav-toggle')
      const siteNav = document.querySelector<HTMLElement>('#site-nav')

      if (menuButton && siteNav) {
        const closeMenu = (restoreFocus = false) => {
          menuButton.setAttribute('aria-expanded', 'false')
          menuButton.setAttribute('aria-label', 'Apri il menu')
          siteNav.hidden = true
          if (restoreFocus) menuButton.focus()
        }

        const syncMenuForViewport = () => {
          const isMobile = mobileMenuQuery.matches
          menuButton.hidden = !isMobile
          menuButton.setAttribute('aria-expanded', 'false')
          menuButton.setAttribute('aria-label', 'Apri il menu')
          siteNav.hidden = isMobile
        }

        menuButton.addEventListener('click', () => {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true'
          if (isExpanded) {
            closeMenu()
            return
          }

          siteNav.hidden = false
          menuButton.setAttribute('aria-expanded', 'true')
          menuButton.setAttribute('aria-label', 'Chiudi il menu')
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenuQuery.matches && !siteNav.hidden) {
            closeMenu(true)
          }
        })

        document.addEventListener('pointerdown', (event) => {
          const target = event.target as Node
          if (mobileMenuQuery.matches && !siteNav.hidden && !siteNav.contains(target) && !menuButton.contains(target)) {
            closeMenu()
          }
        })

        siteNav.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a') && mobileMenuQuery.matches) closeMenu()
        })

        mobileMenuQuery.addEventListener('change', syncMenuForViewport)
        syncMenuForViewport()
      }
    </script>
  </body>
</html>
