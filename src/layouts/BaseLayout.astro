---
import '../styles/global.css'
import { sitePath } from '../lib/public-content'

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = 'LuLab | Restauro, recupero e lavori artigianali nel Salento',
  description = 'LuLab restaura mobili e infissi, recupera arredi e realizza trattamenti antitarlo nel Salento.',
  image = sitePath('/brand/logo-lulab.png?v=20261015')
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
const brandIcon = sitePath('/brand/logo-lulab.png?v=20261015')
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F4EF" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={brandIcon} type="image/png" sizes="1024x1024" />
    <link rel="apple-touch-icon" href={brandIcon} sizes="1024x1024" />
    <link rel="manifest" href={sitePath('/site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Marchio geometrico LuLab" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand" href={sitePath('/')} aria-label="LuLab — home">
        <img src={sitePath('/brand/logo-lulab.png')} width="64" height="64" alt="" />
        <span>LuLab</span>
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Apri il menu"
        hidden
      >
        <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path class="menu-line menu-line-top" d="M4 7h16" />
          <path class="menu-line menu-line-middle" d="M4 12h16" />
          <path class="menu-line menu-line-bottom" d="M4 17h16" />
        </svg>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Navigazione principale">
        <a href={sitePath('/servizi/')}>Servizi</a>
        <a href={sitePath('/collezione/')}>Collezione</a>
        <a href={sitePath('/progetti/')}>Progetti</a>
        <a class="nav-cta" href={sitePath('/richiesta/')}>Richiedi un preventivo</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand-lockup">
        <img src={sitePath('/brand/logo-lulab.png')} width="64" height="64" alt="" loading="lazy" />
        <div><strong>LuLab</strong><p>Restauro, recupero e lavorazioni artigianali nel Salento.</p></div>
      </div>
      <div class="footer-links">
        <a href="mailto:lulabworks@gmail.com">lulabworks@gmail.com</a>
        <a href="https://www.instagram.com/lulabworks/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.youtube.com/@LuLabWorks" target="_blank" rel="noopener noreferrer">YouTube</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} LuLab</p>
    </footer>
    <script>
      const mobileMenuQuery = window.matchMedia('(max-width: 800px)')
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
      const menuButton = document.querySelector<HTMLButtonElement>('.nav-toggle')
      const siteNav = document.querySelector<HTMLElement>('#site-nav')

      if (menuButton && siteNav) {
        let closeTimer: number | undefined
        let openFrame: number | undefined

        const cancelPendingClose = () => {
          if (closeTimer !== undefined) window.clearTimeout(closeTimer)
          closeTimer = undefined
        }

        const cancelPendingOpen = () => {
          if (openFrame !== undefined) window.cancelAnimationFrame(openFrame)
          openFrame = undefined
        }

        const closeMenu = (restoreFocus = false) => {
          cancelPendingOpen()
          cancelPendingClose()
          menuButton.setAttribute('aria-expanded', 'false')
          menuButton.setAttribute('aria-label', 'Apri il menu')
          siteNav.inert = true
          siteNav.setAttribute('aria-hidden', 'true')
          siteNav.classList.remove('is-open')
          if (restoreFocus) menuButton.focus()

          const finishClosing = () => {
            closeTimer = undefined
            if (menuButton.getAttribute('aria-expanded') === 'false') siteNav.hidden = true
          }

          if (reducedMotionQuery.matches) finishClosing()
          else closeTimer = window.setTimeout(finishClosing, 270)
        }

        const syncMenuForViewport = () => {
          cancelPendingOpen()
          cancelPendingClose()
          document.documentElement.classList.add('has-mobile-menu')
          const isMobile = mobileMenuQuery.matches
          menuButton.hidden = !isMobile
          menuButton.setAttribute('aria-expanded', 'false')
          menuButton.setAttribute('aria-label', 'Apri il menu')
          siteNav.hidden = isMobile
          siteNav.inert = isMobile
          if (isMobile) siteNav.setAttribute('aria-hidden', 'true')
          else siteNav.removeAttribute('aria-hidden')
          siteNav.classList.remove('is-open')
        }

        menuButton.addEventListener('click', () => {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true'
          if (isExpanded) {
            closeMenu()
            return
          }

          cancelPendingOpen()
          cancelPendingClose()
          siteNav.hidden = false
          siteNav.inert = false
          siteNav.removeAttribute('aria-hidden')
          menuButton.setAttribute('aria-expanded', 'true')
          menuButton.setAttribute('aria-label', 'Chiudi il menu')
          // Flush the collapsed state before starting the CSS transition.
          void siteNav.offsetHeight
          openFrame = window.requestAnimationFrame(() => {
            openFrame = undefined
            if (menuButton.getAttribute('aria-expanded') === 'true') siteNav.classList.add('is-open')
          })
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenuQuery.matches && menuButton.getAttribute('aria-expanded') === 'true') {
            closeMenu(true)
          }
        })

        document.addEventListener('pointerdown', (event) => {
          const target = event.target as Node
          if (mobileMenuQuery.matches && menuButton.getAttribute('aria-expanded') === 'true' && !siteNav.contains(target) && !menuButton.contains(target)) {
            closeMenu()
          }
        })

        siteNav.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a') && mobileMenuQuery.matches && menuButton.getAttribute('aria-expanded') === 'true') closeMenu()
        })

        mobileMenuQuery.addEventListener('change', syncMenuForViewport)
        syncMenuForViewport()
      }
    </script>
  </body>
</html>
