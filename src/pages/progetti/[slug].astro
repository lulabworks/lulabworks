---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPortfolioProjects, publicImageUrl, sitePath, type PortfolioProject } from '../../lib/public-content'

export async function getStaticPaths() {
  const projects = await getPortfolioProjects()
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

interface Props { project: PortfolioProject }
const { project } = Astro.props
const cover = project.images[0]
const kindLabels = { prima: 'Prima', durante: 'Durante', dopo: 'Dopo' }
---

<BaseLayout title={project.seo_title ?? `${project.title} | Progetti LuLab`} description={project.seo_description ?? project.summary.slice(0, 170)} image={cover ? publicImageUrl(cover.storage_path) : undefined}>
  <section class="detail-hero">
    <div class="narrow">
      <p class="eyebrow">{project.category}</p>
      <h1 class="page-title">{project.title}</h1>
      <p class="lead">{project.summary}</p>
    </div>
  </section>
  {cover && <img class="detail-cover" src={publicImageUrl(cover.storage_path)} alt={cover.alt_text} width={cover.width ?? 1400} height={cover.height ?? 1000} />}
  <section class="section"><div class="narrow"><p class="detail-copy">{project.description}</p><div class="actions"><a class="button button-primary" href={`${sitePath('/richiesta/')}?tipo=Richiesta%20simile&oggetto=${encodeURIComponent(project.title)}`}>Parlaci del tuo progetto</a></div></div></section>
  {project.images.length > 1 && <section class="section"><div class="container gallery">{project.images.slice(1).map((image) => <figure><img src={publicImageUrl(image.storage_path)} alt={image.alt_text} width={image.width ?? 1200} height={image.height ?? 900} loading="lazy" /><figcaption>{image.caption ?? kindLabels[image.image_kind]}</figcaption></figure>)}</div></section>}
</BaseLayout>
