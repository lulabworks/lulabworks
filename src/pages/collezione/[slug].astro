---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { availabilityLabels, getCollectionItems, publicImageUrl, sitePath, type CollectionItem } from '../../lib/public-content'

export async function getStaticPaths() {
  const items = await getCollectionItems()
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}

interface Props { item: CollectionItem }
const { item } = Astro.props
const cover = item.images[0]
---

<BaseLayout title={item.seo_title ?? `${item.title} | Collezione LuLab`} description={item.seo_description ?? item.description.slice(0, 170)} image={cover ? publicImageUrl(cover.storage_path) : undefined}>
  <section class="detail-hero">
    <div class="narrow">
      <p class="eyebrow">Collezione LuLab · {availabilityLabels[item.availability]}</p>
      <h1 class="page-title">{item.title}</h1>
      <p class="lead">Per informazioni e disponibilità contatta direttamente il laboratorio.</p>
    </div>
  </section>
  {cover && <img class="detail-cover" src={publicImageUrl(cover.storage_path)} alt={cover.alt_text} width={cover.width ?? 1400} height={cover.height ?? 1000} />}
  <section class="section">
    <div class="narrow">
      <p class="detail-copy">{item.description}</p>
      <dl class="facts">
        {item.materials && <div class="fact"><dt>Materiali</dt><dd>{item.materials}</dd></div>}
        {item.dimensions && <div class="fact"><dt>Dimensioni</dt><dd>{item.dimensions}</dd></div>}
        {item.condition_description && <div class="fact"><dt>Condizioni</dt><dd>{item.condition_description}</dd></div>}
        <div class="fact"><dt>Disponibilità</dt><dd>{availabilityLabels[item.availability]}</dd></div>
      </dl>
      <div class="actions"><a class="button button-primary" href={`${sitePath('/richiesta/')}?tipo=Informazioni%20Collezione&oggetto=${encodeURIComponent(item.title)}`}>Chiedi informazioni</a></div>
    </div>
  </section>
  {item.images.length > 1 && <section class="section"><div class="container gallery">{item.images.slice(1).map((image) => <figure><img src={publicImageUrl(image.storage_path)} alt={image.alt_text} width={image.width ?? 1200} height={image.height ?? 900} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div></section>}
</BaseLayout>
